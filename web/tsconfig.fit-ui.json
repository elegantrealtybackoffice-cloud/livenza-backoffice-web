{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "tests/fit-offline-stubs.d.ts",
    "src/lib/fit/**/*.ts",
    "src/app/fit/**/*.tsx"
  ]
}
