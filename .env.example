DATABASE_URL=postgresql://...
SECRET_KEY=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
FORCE_HTTPS=1
MAX_UPLOAD_MB=64
# Livenza's application limit. Supabase bucket/global limits still apply.
VIDEO_WALL_MAX_MB=2048
OMP_NUM_THREADS=1
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.6-luna
# Optional enhancement only. Tesla OS 27 includes server-local Aadhaar OCR.
OPENAI_AADHAAR_MODEL=gpt-5.6-luna

# WhatsApp Business Cloud API (required for unattended automatic messages/documents)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
VACANT_REPORT_JOB_TOKEN=

# Live query connectors
QUERY_WEBHOOK_TOKEN=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
GOOGLE_LEAD_WEBHOOK_SECRET=

# Optional authorized Aadhaar AUA/KUA provider adapter
AADHAAR_AUTH_URL=
AADHAAR_AUTH_TOKEN=
# Optional custom coordinates for the default Live Companion weather city.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Tesla OS 27 — Livenza Vault / Electricity Bill Studio
LIVENZA_VAULT_MASTER_KEY=
BBPS_PROVIDER_BASE_URL=
BBPS_PROVIDER_CLIENT_ID=
BBPS_PROVIDER_CLIENT_SECRET=
BBPS_PROVIDER_FETCH_PATH=/bill-fetch
ELECTRICITY_PAYMENT_PROVIDER=Bharat Connect / BBPS
ELECTRICITY_PAYMENT_PROVIDER_URL=
ELECTRICITY_PAYMENT_CALLBACK_SECRET=

# Optional mascot model override. Defaults to gpt-image-2 in app.py.
OPENAI_AVATAR_MODEL=gpt-image-2
# Used by existing encrypted integrations and uploaded bank/electricity bill blobs.
INTEGRATION_ENCRYPTION_KEY=

# Livenza.life consumer web (Next.js)
# Server-side origin used by web/ for /api/v1 rewrites and server components.
LIVENZA_API_ORIGIN=https://api.livenza.life
# Canonical public origin used for sitemap/canonical metadata.
LIVENZA_SITE_URL=https://livenza.life
