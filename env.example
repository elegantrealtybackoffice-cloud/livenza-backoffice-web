DATABASE_URL=postgresql://...
SECRET_KEY=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
FORCE_HTTPS=1
MAX_UPLOAD_MB=64
# Livenza's application limit. Supabase bucket/global limits still apply.
VIDEO_WALL_MAX_MB=2048
OMP_NUM_THREADS=1
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.6-luna
# Optional enhancement only. Tesla OS 27 includes server-local Aadhaar OCR.
OPENAI_AADHAAR_MODEL=gpt-5.6-luna

# WhatsApp Business Cloud API (required for unattended automatic messages/documents)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
VACANT_REPORT_JOB_TOKEN=

# Live query connectors
QUERY_WEBHOOK_TOKEN=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
GOOGLE_LEAD_WEBHOOK_SECRET=

# Optional authorized Aadhaar AUA/KUA provider adapter
AADHAAR_AUTH_URL=
AADHAAR_AUTH_TOKEN=
# Optional custom coordinates for the default Live Companion weather city.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Tesla OS 27 — Livenza Vault / Electricity Bill Studio
LIVENZA_VAULT_MASTER_KEY=
BBPS_PROVIDER_BASE_URL=
BBPS_PROVIDER_CLIENT_ID=
BBPS_PROVIDER_CLIENT_SECRET=
BBPS_PROVIDER_FETCH_PATH=/bill-fetch
ELECTRICITY_PAYMENT_PROVIDER=Bharat Connect / BBPS
ELECTRICITY_PAYMENT_PROVIDER_URL=
ELECTRICITY_PAYMENT_CALLBACK_SECRET=

# Optional mascot model override. Defaults to gpt-image-2 in app.py.
OPENAI_AVATAR_MODEL=gpt-image-2
# Used by existing encrypted integrations and uploaded bank/electricity bill blobs.
INTEGRATION_ENCRYPTION_KEY=

# Livenza.life consumer web (Next.js)
# Server-side origin used by web/ for /api/v1 rewrites and server components.
LIVENZA_API_ORIGIN=https://api.livenza.life
# Canonical public origin used for sitemap/canonical metadata.
LIVENZA_SITE_URL=https://livenza.life

# Livenza.life Plan 3 / Tenant OS — booking, dues and payments
# New customer-facing payments use Cashfree. Keep credentials server-side only.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Development/test only. Production must remain 0.
CASHFREE_TEST_STUB=0
# Optional legacy secret for reconciling historic Razorpay webhook events only.
RAZORPAY_WEBHOOK_SECRET=
BOOKING_PAYMENT_HOLD_MINUTES=20
# Public booking add-ons are server-priced from this JSON. Example:
# BOOKING_ADDONS_JSON=[{"code":"move_in_kit","label":"Move-In Kit","amount_minor":199900,"active":true}]
BOOKING_ADDONS_JSON=[]
PARENT_SHARE_EXPIRY_HOURS=24

# Livenza.store resident delivery: comma-separated StayProperty slugs enabled for internal room delivery.
LIVENZA_INTERNAL_DELIVERY_PROPERTIES=
# Livenza+ earning rule. Example: 1 point for every INR 100 of eligible paid value.
LIVENZA_POINTS_PER_100_INR=1

# Livenza.life Plan 5 — environment, storage and release verification
# Use development/staging locally. Render production sets this to production.
LIVENZA_ENV=development
# Development/test only. Must remain 0 in production.
CUSTOMER_AUTH_TEST_MODE=0
# Private/public object storage. Keep service role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIVENZA_PRIVATE_BUCKET=livenza-private
LIVENZA_PUBLIC_BUCKET=livenza-public
# Temporary staff-only launch verification credential; use at least 32 random characters and rotate/remove after launch verification.
LIVENZA_POSTDEPLOY_TOKEN=

# Livenza Tenant OS Release 3 — Radius/Xenius prepaid electricity
# Keep disabled until Radius supplies the private partner API contract.
RADIUS_ENABLED=0
# Development/test only. Production must remain 0.
RADIUS_TEST_STUB=0
RADIUS_BASE_URL=
RADIUS_AUTH_TOKEN=
RADIUS_AUTH_HEADER=Authorization
RADIUS_AUTH_SCHEME=Bearer
# Partner-provided path templates. Do not guess live Radius endpoints.
RADIUS_SNAPSHOT_PATH=
RADIUS_RECHARGE_PATH=
RADIUS_STATUS_PATH=
METER_RECHARGE_MIN_MINOR=1000
METER_RECHARGE_MAX_MINOR=5000000

# Staff Salary Studio — automatic biometric attendance feed
# Set a long random token. Biometric gateway/device middleware sends it as X-Livenza-Webhook-Token.
STAFF_ATTENDANCE_WEBHOOK_TOKEN=
